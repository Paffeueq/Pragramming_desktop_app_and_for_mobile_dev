<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="%XDT_SCMSITEEXTENSION_EXTENSIONPATH%">
    <system.webServer>
      <security>
        <authorization>
          <add accessType="Allow" users="*" />
        </authorization>
      </security>
    </system.webServer>
  </location>
  <appSettings>
    <add key="ASPNETCORE_ENVIRONMENT" value="Production" />
  </appSettings>
  <system.webServer>
    <webSocket enabled="false" />
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath="dotnet" arguments=".\HostingApp.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="outofprocess" />
  </system.webServer>
</configuration>
